{
  "version": 1,
  "knowledge_root": "/absolute/path/to/knowledge-base",
  "domains": [
    {
      "id": "product-platform",
      "label": "产品平台",
      "description": "归属于产品平台系统族的知识。",
      "aliases": [
        "product-system"
      ],
      "workspace_contains": [
        "/work/product-platform/"
      ],
      "include_when": [
        "相关行为、数据或决策由产品平台负责。"
      ],
      "exclude_when": [
        "主题是可复用的工程指导，不归属于某个具体产品。"
      ]
    },
    {
      "id": "general",
      "label": "通用知识",
      "description": "不归属于某个已配置产品的可复用知识。",
      "aliases": [
        "other"
      ],
      "workspace_contains": [],
      "include_when": [
        "有依据确认该知识不依赖具体产品。"
      ],
      "exclude_when": []
    }
  ],
  "default_domain": "general",
  "storage_backend": "auto",
  "obsidian": {
    "command": "obsidian",
    "vault": null
  },
  "python": {
    "mode": "auto",
    "uv_command": [
      "uv"
    ]
  },
  "authoring_profile": {
    "id": "default",
    "file": null
  },
  "preferred_remote_hosts": []
}
